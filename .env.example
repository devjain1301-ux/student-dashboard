# College Dashboard - Backend Environment Configuration Example
# Copy this file to .env and set secure values for production

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key (Use a strong random 256-bit string in production)
JWT_SECRET=change_this_to_a_secure_random_secret_in_production_unisphere_2026

# JWT Expiration Duration
JWT_EXPIRES_IN=24h

# Allowed CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database File Path
DB_PATH=./server/data/college_dashboard.db

# Max File Upload Size (in bytes, 15MB default)
MAX_UPLOAD_BYTES=15728640
