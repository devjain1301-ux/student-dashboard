{
  "name": "college-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Smart College Student Dashboard - Real-time timetable, 75% attendance predictor, study notes with PDF attachments, transit ticket tracker, CGPA calculator, and 4-digit security PIN vault.",
  "main": "main.js",
  "scripts": {
    "dev": "serve -l 5173 .",
    "start": "serve .",
    "server": "node server/server.js",
    "start:server": "node server/server.js",
    "build:app": "node scripts/sync-app.js",
    "cap:sync": "node scripts/sync-app.js ; npx cap sync android",
    "cap:open:android": "npx cap open android",
    "desktop": "electron ."
  },
  "keywords": [
    "college-dashboard",
    "student-portal",
    "attendance-tracker",
    "timetable-manager",
    "pdf-notes",
    "cgpa-calculator",
    "travel-tracker"
  ],
  "author": "Dev Jain",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "electron": "^43.4.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "sqlite3": "^6.0.1"
  }
}
